void loop() {
  // Check button presses (buttons are active HIGH with pull-down resistors)
  if (digitalRead(BTN_GROUND) == HIGH) {
    targetFloor = 1;  // Ground floor
    Serial.println("Button 1 pressed - Moving to Ground Floor");
    delay(300); // Debounce
    
    // Only move if we're not already there
    if (currentFloor != targetFloor) {
      moveElevator(targetFloor);
    } else {
      Serial.println("Already at Ground Floor");
    }
  }
  else if (digitalRead(BTN_FIRST) == HIGH) {
    targetFloor = 2;  // First floor
    Serial.println("Button 2 pressed - Moving to First Floor");
    delay(300); // Debounce
    
    // Only move if we're not already there
    if (currentFloor != targetFloor) {
      moveElevator(targetFloor);
    } else {
      Serial.println("Already at First Floor");
    }
  }
  else if (digitalRead(BTN_SECOND) == HIGH) {
    targetFloor = 3;  // Second floor
    Serial.println("Button 3 pressed - Moving to Second Floor");
    delay(300); // Debounce
    
    // Only move if we're not already there
    if (currentFloor != targetFloor) {
      moveElevator(targetFloor);
    } else {
      Serial.println("Already at Second Floor");
    }
  }
}
void moveElevator(int target) {
  Serial.print("Current floor: ");
  Serial.println(currentFloor);
  Serial.print("Target floor: ");
  Serial.println(target);
  
  // Calculate total steps needed (direct movement, no stops)
  int floorDifference = target - currentFloor;
  int totalSteps = abs(floorDifference) * stepsPerFloor;
  
  if (floorDifference > 0) {
    // Move UP directly to target floor
    Serial.print("Moving UP directly to floor ");
    Serial.println(target);
    
    moveStepsUp(totalSteps);
    currentFloor = target;
    updateDisplay(currentFloor);
    updateLEDs(currentFloor);
    
    Serial.print("Arrived at floor ");
    Serial.println(currentFloor);
  }
  else if (floorDifference < 0) {
    // Move DOWN directly to target floor
    Serial.print("Moving DOWN directly to floor ");
    Serial.println(target);
    
    moveStepsDown(totalSteps);
    currentFloor = target;
    updateDisplay(currentFloor);
    updateLEDs(currentFloor);
    
    Serial.print("Arrived at floor ");
    Serial.println(currentFloor);
  }
  
  Serial.println("Waiting for next button press...");
}

void moveStepsUp(int steps) {
  // Rotate motor clockwise to move elevator UP
  Serial.println("Motor rotating UP (clockwise)...");
  for (int i = 0; i < steps; i++) {
    digitalWrite(IN1, stepSequence[currentStep][0]);
    digitalWrite(IN2, stepSequence[currentStep][1]);
    digitalWrite(IN3, stepSequence[currentStep][2]);
    digitalWrite(IN4, stepSequence[currentStep][3]);
    
    currentStep++;
    if (currentStep >= 😍 currentStep = 0;
    
    delay(stepDelay);
  }
  stopMotor();
  Serial.println("Motor stopped");
}

void moveStepsDown(int steps) {
  // Rotate motor counter-clockwise to move elevator DOWN
  Serial.println("Motor rotating DOWN (counter-clockwise)...");
  for (int i = 0; i < steps; i++) {
    digitalWrite(IN1, stepSequence[currentStep][0]);
    digitalWrite(IN2, stepSequence[currentStep][1]);
    digitalWrite(IN3, stepSequence[currentStep][2]);
    digitalWrite(IN4, stepSequence[currentStep][3]);
    
    currentStep--;
    if (currentStep < 0) currentStep = 7;
    
    delay(stepDelay);
  }
  stopMotor();
  Serial.println("Motor stopped");
}

void stopMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

Shisir ETE, [1/22/2026 1:46 PM]
void updateDisplay(int floor) {
  // Display numbers 1, 2, or 3 on seven segment display
  // COMMON CATHODE configuration (HIGH = ON, LOW = OFF)
  switch(floor) {
    case 1: // Display "1" (Ground Floor)
      digitalWrite(SEG_A, LOW);
      digitalWrite(SEG_B, HIGH);
      digitalWrite(SEG_C, HIGH);
      digitalWrite(SEG_D, LOW);
      digitalWrite(SEG_E, LOW);
      digitalWrite(SEG_F, LOW);
      digitalWrite(SEG_G, LOW);
      break;
      
    case 2: // Display "2" (First Floor)
      digitalWrite(SEG_A, HIGH);
      digitalWrite(SEG_B, HIGH);
      digitalWrite(SEG_C, LOW);
      digitalWrite(SEG_D, HIGH);
      digitalWrite(SEG_E, HIGH);
      digitalWrite(SEG_F, LOW);
      digitalWrite(SEG_G, HIGH);
      break;
      
    case 3: // Display "3" (Second Floor)
      digitalWrite(SEG_A, HIGH);
      digitalWrite(SEG_B, HIGH);
      digitalWrite(SEG_C, HIGH);
      digitalWrite(SEG_D, HIGH);
      digitalWrite(SEG_E, LOW);
      digitalWrite(SEG_F, LOW);
      digitalWrite(SEG_G, HIGH);
      break;
  }
}

void updateLEDs(int floor) {
  // Turn on LED for current floor, turn off others
  digitalWrite(LED_GROUND, floor == 1 ? HIGH : LOW);
  digitalWrite(LED_FIRST, floor == 2 ? HIGH : LOW);
  digitalWrite(LED_SECOND, floor == 3 ? HIGH : LOW);
}